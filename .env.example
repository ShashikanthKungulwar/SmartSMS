PORT=
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REDIS_HOST=
REDIS_PORT=

# Comma-separated list of allowed CORS origins. Empty/unset falls back to '*' (dev only) —
# set real origins in production, e.g. "https://app.example.com,https://admin.example.com"
ALLOWED_ORIGINS=

# Shared secret for internal service-to-service calls (ai-service -> backend /api/feedback/pending, /mark-used)
INTERNAL_SERVICE_TOKEN=

NODE_ENV=

# Used by ai-service to reach the backend
BACKEND_URL=

# Used by backend to reach ai-service
AI_SERVICE_URL=
